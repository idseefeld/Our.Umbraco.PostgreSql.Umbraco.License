<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<CompressionEnabled>false</CompressionEnabled>
		<!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="uSync\**" />
	  <Content Remove="uSync\**" />
	  <EmbeddedResource Remove="uSync\**" />
	  <None Remove="uSync\**" />
	</ItemGroup>
	<ItemGroup>
	  <AdditionalFiles Remove="Views\Page.cshtml" />
	</ItemGroup>

	<ItemGroup>
		<!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
		<PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
		<PackageReference Include="Umbraco.Cms" Version="17.9.0-rc" />
		<ProjectReference Include="..\NPoco\src\NPoco.Abstractions\NPoco.Abstractions.csproj" />
		<ProjectReference Include="..\NPoco\src\NPoco.SqlServer\NPoco.SqlServer.csproj" />
		<ProjectReference Include="..\NPoco\src\NPoco\NPoco.csproj" />
		<ProjectReference Include="..\Package\Our.Umbraco.PostgreSql.Umbraco.License\Our.Umbraco.PostgreSql.Umbraco.License.pack.csproj" />
		<RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Razor files are needed for the backoffice to work correctly -->
		<CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
		<UserSecretsId>23b5a1af-39ed-40dd-b95c-d1a3a34026da</UserSecretsId>
	</PropertyGroup>


</Project>
